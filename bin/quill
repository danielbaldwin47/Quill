#!/usr/bin/env bash
# Quill — open the editor in its own window, with no browser chrome around it.
# Owner: latency piece.
#
#   bin/quill                          open Quill (starts the local server if it is not running)
#   bin/quill --fresh                  open it with a brand new browser profile (a true first run)
#   bin/quill --measure                open it, print cold-start numbers as JSON, close it again
#   bin/quill --measure --runs 5       repeat the cold start five times and report all of them
#   bin/quill --measure --keys 300     also run the keystroke bench in that window, on the compositor
#   bin/quill --measure --sessions 3   ... three times over, for a run-to-run interval
#   bin/quill --measure --virtual      put the window on a virtual Hyprland output (the default)
#   bin/quill --measure --ws 4         put it on workspace 4 of the real monitor instead
#
# Cold start is timed from the moment this script is about to exec the browser (the server is
# already up by then) to the first frame that actually shows the document. It therefore includes
# the browser process spawn, profile initialisation, window creation, navigation, font loading
# and the full render of whatever document was open.
#
# WHERE THE WINDOW GOES. BRIEF.md forbids opening a test window on the workspace the user is
# working on. Hyprland 0.56 dropped the old `hyprctl dispatch exec "[rules] cmd"` string parser
# for a Lua one, so the placement call is
#     hyprctl repl 'return hl.dispatch(hl.dsp.exec_cmd("[workspace N silent] cmd"))'
# and it works. A window on a workspace that is not being displayed, though, gets no frame
# callbacks, so its presentation timestamps are worthless. The default is therefore --virtual:
# `hyprctl output create headless` adds a 1920x1080@60 virtual output, the window opens on that
# output's own workspace, and the user's Hyprland really composites and presents it at 60 Hz —
# nothing appears on the physical panel and nothing on the user's workspaces is touched. The
# output is removed again when the run finishes.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PORT=${QUILL_PORT:-4173}
CHROME=${QUILL_CHROME:-/usr/bin/chromium}
PROFILE=${QUILL_PROFILE:-$HOME/.cache/quill/browser}
SIZE=${QUILL_SIZE:-1440,900}
URL=""
measure=0; fresh=0; keys=0; seed=0; doc=""; out=""; runs=1; sessions=1; place="virtual"; ws=""; regimes=""; throttle=""; snapshot=""; rmotion=0; clock=""

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }
while [ $# -gt 0 ]; do
  case "$1" in
    --measure) measure=1 ;;
    --fresh)   fresh=1 ;;
    --seed)    seed=1 ;;          # leave the benchmark document in this profile for the next launch
    --keys)    keys="$2"; shift ;;
    --runs)    runs="$2"; shift ;;
    --sessions) sessions="$2"; shift ;;
    --regimes) regimes="$2"; shift ;;
    --throttle) throttle="$2"; shift ;;
    --doc)     doc="$2"; shift ;;
    --json)    out="$2"; shift ;;
    --port)    PORT="$2"; shift ;;
    --profile) PROFILE="$2"; shift ;;
    --size)    SIZE="$2"; shift ;;
    --url)     URL="$2"; shift ;;
    --snapshot) snapshot="$2"; shift ;;
    --reduced-motion) rmotion=1 ;;
    --clock)   clock="$2"; shift ;;
    --virtual) place="virtual" ;;
    --ws)      place="workspace"; ws="$2"; shift ;;
    --here)    place="here" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "quill: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$URL" ] || URL="http://localhost:$PORT/"

# --- the document server -----------------------------------------------------
if ! curl -sf -o /dev/null "http://localhost:$PORT/"; then
  node "$ROOT/tools/serve.mjs" "$PORT" >/dev/null 2>&1 &
  for _ in $(seq 1 100); do curl -sf -o /dev/null "http://localhost:$PORT/" && break; sleep 0.05; done
fi

# --- profile -----------------------------------------------------------------
case "$PROFILE" in *quill*) : ;; *) echo "quill: refusing to use a profile dir without 'quill' in its path" >&2; exit 2 ;; esac
wipe_profile() { if [ -d "$PROFILE" ]; then rm -rf -- "$PROFILE"; fi; mkdir -p "$PROFILE"; }
if [ "$fresh" = 1 ]; then wipe_profile; else mkdir -p "$PROFILE"; fi

FLAGS=(
  --app="$URL"
  --user-data-dir="$PROFILE"
  --class=Quill --name=quill
  --window-size="$SIZE"
  --no-first-run --no-default-browser-check --disable-component-update
  --disable-background-networking --disable-sync --disable-features=Translate,MediaRouter
  --ozone-platform-hint=auto
)

if [ "$measure" = 0 ]; then
  exec "$CHROME" "${FLAGS[@]}"
fi

# --- where the measured window goes -----------------------------------------
have_hypr=0; if command -v hyprctl >/dev/null 2>&1; then have_hypr=1; fi
VIRTUAL_OUT=""; TARGET_WS=""
hypr_exec() { hyprctl repl "return hl.dispatch(hl.dsp.exec_cmd(\"$1\"))" >/dev/null 2>&1; }

make_virtual_output() {
  QUILL_MONS_BEFORE=$(hyprctl monitors -j | python3 -c "import json,sys;print(' '.join(m['name'] for m in json.load(sys.stdin)))")
  export QUILL_MONS_BEFORE
  hyprctl output create headless >/dev/null 2>&1 || return 1
  sleep 0.5
  VIRTUAL_OUT=$(hyprctl monitors -j | python3 -c "import json,sys,os
have=set(os.environ.get('QUILL_MONS_BEFORE','').split())
new=[m['name'] for m in json.load(sys.stdin) if m['name'] not in have]
print(new[0] if new else '')")
  [ -n "$VIRTUAL_OUT" ] || return 1
  export QUILL_VOUT="$VIRTUAL_OUT"
  TARGET_WS=$(hyprctl monitors -j | python3 -c "import json,sys,os
for m in json.load(sys.stdin):
    if m['name'] == os.environ['QUILL_VOUT']: print(m['activeWorkspace']['id'])")
  [ -n "$TARGET_WS" ]
}
drop_virtual_output() { if [ -n "$VIRTUAL_OUT" ]; then hyprctl output remove "$VIRTUAL_OUT" >/dev/null 2>&1 || true; fi; VIRTUAL_OUT=""; }

trap 'drop_virtual_output' EXIT INT TERM
case "$place" in
  virtual)
    if [ "$have_hypr" = 1 ] && make_virtual_output; then
      echo "quill: measuring on virtual output $VIRTUAL_OUT (workspace $TARGET_WS) — nothing is shown on the physical screen" >&2
    else
      echo "quill: could not create a virtual output; refusing to open a window on the user's screen." >&2
      echo "       Use --ws N for a free workspace, --here with QUILL_HEADED_OK=1, or measure headless" >&2
      echo "       with: node tools/latency.mjs" >&2
      exit 3
    fi ;;
  workspace)
    [ "$have_hypr" = 1 ] || { echo "quill: --ws needs hyprctl" >&2; exit 3; }
    TARGET_WS="$ws"
    active=$(hyprctl activeworkspace -j | python3 -c "import json,sys;print(json.load(sys.stdin)['id'])")
    if [ "$TARGET_WS" = "$active" ]; then echo "quill: workspace $ws is the one in use — refusing" >&2; exit 3; fi ;;
  here)
    [ "${QUILL_HEADED_OK:-0}" = "1" ] || { echo "quill: --here opens a window on the active workspace; set QUILL_HEADED_OK=1 if that is really wanted" >&2; exit 3; } ;;
esac

# --- measured launches -------------------------------------------------------
results=()
for run in $(seq 1 "$runs"); do
  DBG=$((9300 + RANDOM % 400))
  if [ "$fresh" = 1 ] && [ "$run" -gt 1 ]; then wipe_profile; fi
  cmd="$CHROME"
  for f in "${FLAGS[@]}" --remote-debugging-port="$DBG"; do cmd="$cmd $f"; done
  pid=""
  if [ -n "$TARGET_WS" ]; then
    t0=$(date +%s%3N)                                 # wall clock, ms, immediately before exec
    hypr_exec "[workspace $TARGET_WS silent] $cmd"
  else
    t0=$(date +%s%3N)
    "$CHROME" "${FLAGS[@]}" --remote-debugging-port="$DBG" >/dev/null 2>&1 &
    pid=$!
  fi
  for _ in $(seq 1 600); do curl -sf -o /dev/null "http://127.0.0.1:$DBG/json/version" && break; sleep 0.02; done

  argv=( --attach "$DBG" --t0 "$t0" --profile "$PROFILE" --where "${VIRTUAL_OUT:-workspace $TARGET_WS}" )
  if [ -n "$snapshot" ]; then argv+=( --snapshot "$snapshot" ); fi
  if [ "$rmotion" = 1 ]; then argv+=( --reduced-motion ); fi
  if [ -n "$clock" ]; then argv+=( --clock "$clock" ); fi
  if [ "$run" = "$runs" ] && [ "$keys" != 0 ]; then
    argv+=( --keys "$keys" --sessions "$sessions" )
    if [ -n "$regimes" ]; then argv+=( --regimes "$regimes" ); fi
    if [ -n "$throttle" ]; then argv+=( --throttle "$throttle" ); fi
  else
    argv+=( --keys 0 )
  fi
  if [ -n "$doc" ]; then argv+=( --doc "$doc" ); fi
  if [ "$seed" = 1 ] && [ "$run" = "$runs" ]; then argv+=( --seed ); fi
  if [ -n "$out" ]; then
    node "$ROOT/tools/latency.mjs" "${argv[@]}" --json "${out%.json}-$run.json" --quiet || true
    results+=( "${out%.json}-$run.json" )
  else
    node "$ROOT/tools/latency.mjs" "${argv[@]}" || true
  fi

  if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
  else pkill -f -- "--remote-debugging-port=$DBG" 2>/dev/null || true; fi
  sleep 0.6
done
if [ ${#results[@]} -gt 0 ]; then echo "quill: wrote ${results[*]}" >&2; fi

+// THROWAWAY (#147). The four shapes of the caret's column, chosen by
+// `QUILL_CARET_SHAPE` so one build can be shot at all of them: 1 as-is
+// (the default, and byte-identical to the unpatched build), 2 the free
+// caret without `caret::NUDGE`, 3 the selection's end bars placed where
+// the free caret would stand at that end's offset, 4 both. This never
+// lands — the branch reverts it before it is committed.
+fn shape_147() -> u8 {
+    std::env::var("QUILL_CARET_SHAPE")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(1)
+}
+
+// The nudge the free caret carries under the shape being shot: none under 2
+// and 4, `caret::NUDGE` under 1 and 3. Shape 3's end bars stand where the free
+// caret would stand at their offset, so they read this too — which is what
+// makes 4 coherent: drop the nudge for the caret and the bars drop it with it,
+// and the mark still does not move when a selection starts.
+fn caret_nudge_147(size: u32) -> f64 {
+    if matches!(shape_147(), 2 | 4) {
+        0.0
+    } else {
+        caret::nudge(size)
+    }
+}
+

#!/usr/bin/env bash
# Quill — open the editor in its own window, with no browser chrome around it.
# Owner: latency piece.
#
#   legacy/bin/quill                          open Quill (starts the local server if it is not running)
#   legacy/bin/quill --fresh                  open it with a brand new browser profile (a true first run)
#   legacy/bin/quill --measure                open it, print cold-start numbers as JSON, close it again
#   legacy/bin/quill --measure --runs 5       repeat the cold start five times and report all of them
#   legacy/bin/quill --measure --keys 300     also run the keystroke bench in that window, on the compositor
#   legacy/bin/quill --measure --sessions 3   ... three times over, for a run-to-run interval
#   legacy/bin/quill --measure --virtual      put the window on a virtual Hyprland output (the default)
#   legacy/bin/quill --measure --ws 4         put it on workspace 4 of the real monitor instead
#   legacy/bin/quill --measure --panel 3      ... AND show workspace 3 on the physical panel while it runs
#   legacy/bin/quill --measure --uinput       type with real keys through /dev/uinput, not through CDP
#
# Cold start is timed from the moment this script is about to exec the browser (the server is
# already up by then) to the first frame that actually shows the document. It therefore includes
# the browser process spawn, profile initialisation, window creation, navigation, font loading
# and the full render of whatever document was open.
#
# WHERE THE WINDOW GOES. BRIEF.md forbids opening a test window on the workspace the user is
# working on. Hyprland 0.56 dropped the old `hyprctl dispatch exec "[rules] cmd"` string parser
# for a Lua one, so the placement call is
#     hyprctl repl 'return hl.dispatch(hl.dsp.exec_cmd("[workspace N silent] cmd"))'
# and it works. A window on a workspace that is not being displayed, though, gets no frame
# callbacks, so its presentation timestamps are worthless. The default is therefore --virtual:
# `hyprctl output create headless` adds a 1920x1080@60 virtual output, the window opens on that
# output's own workspace, and the user's Hyprland really composites and presents it at 60 Hz —
# nothing appears on the physical panel and nothing on the user's workspaces is touched. The
# output is removed again when the run finishes.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)   # legacy/: the JavaScript app and its own tools
REPO=$(cd "$ROOT/.." && pwd)                                            # the repo root, where the Gate's helpers stay
PORT=${QUILL_PORT:-4173}
CHROME=${QUILL_CHROME:-/usr/bin/chromium}
PROFILE=${QUILL_PROFILE:-$HOME/.cache/quill/browser}
SIZE=${QUILL_SIZE:-1440,900}
URL=""
measure=0; fresh=0; keys=0; seed=0; doc=""; out=""; runs=1; sessions=1; place="virtual"; ws=""; regimes=""; throttle=""; snapshot=""; rmotion=0; clock=""; uinput=0; idle_window=8

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }
while [ $# -gt 0 ]; do
  case "$1" in
    --measure) measure=1 ;;
    --fresh)   fresh=1 ;;
    --seed)    seed=1 ;;          # leave the benchmark document in this profile for the next launch
    --keys)    keys="$2"; shift ;;
    --runs)    runs="$2"; shift ;;
    --sessions) sessions="$2"; shift ;;
    --regimes) regimes="$2"; shift ;;
    --throttle) throttle="$2"; shift ;;
    --doc)     doc="$2"; shift ;;
    --json)    out="$2"; shift ;;
    --port)    PORT="$2"; shift ;;
    --profile) PROFILE="$2"; shift ;;
    --size)    SIZE="$2"; shift ;;
    --url)     URL="$2"; shift ;;
    --snapshot) snapshot="$2"; shift ;;
    --reduced-motion) rmotion=1 ;;
    --clock)   clock="$2"; shift ;;
    --virtual) place="virtual" ;;
    --ws)      place="workspace"; ws="$2"; shift ;;
    --panel)   place="panel"; ws="$2"; shift ;;
    --uinput)  uinput=1 ;;
    --idle-window) idle_window="$2"; shift ;;
    --here)    place="here" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "quill: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

# --- the document server -----------------------------------------------------
# Something answering on the port is not proof that it is Quill: a server left over from a
# checkout that has since moved answers 404 to everything, and the old check ("is anything
# there?") reused it. Ask for a file only Quill serves; if the port is taken by anything else,
# move to the next one.
is_quill() { curl -sf "http://localhost:$1/js/core.js" 2>/dev/null | head -c 64 | grep -q 'Quill core'; }
port_busy() { curl -s -o /dev/null "http://localhost:$1/" 2>/dev/null; }
if ! is_quill "$PORT"; then
  while port_busy "$PORT"; do echo "quill: port $PORT is in use by something else, trying $((PORT+1))" >&2; PORT=$((PORT+1)); done
  node "$ROOT/tools/serve.mjs" "$PORT" >/dev/null 2>&1 &
  for _ in $(seq 1 100); do is_quill "$PORT" && break; sleep 0.05; done
  is_quill "$PORT" || { echo "quill: could not start the document server on port $PORT" >&2; exit 1; }
fi
[ -n "$URL" ] || URL="http://localhost:$PORT/"

# --- profile -----------------------------------------------------------------
case "$PROFILE" in *quill*) : ;; *) echo "quill: refusing to use a profile dir without 'quill' in its path" >&2; exit 2 ;; esac
wipe_profile() { if [ -d "$PROFILE" ]; then rm -rf -- "$PROFILE"; fi; mkdir -p "$PROFILE"; }
if [ "$fresh" = 1 ]; then wipe_profile; else mkdir -p "$PROFILE"; fi

FLAGS=(
  --app="$URL"
  --user-data-dir="$PROFILE"
  --class=Quill --name=quill
  --window-size="$SIZE"
  --no-first-run --no-default-browser-check --disable-component-update
  --disable-background-networking --disable-sync --disable-features=Translate,MediaRouter
  --ozone-platform-hint=auto
)

if [ "$measure" = 0 ]; then
  exec "$CHROME" "${FLAGS[@]}"
fi

# --- where the measured window goes -----------------------------------------
have_hypr=0; if command -v hyprctl >/dev/null 2>&1; then have_hypr=1; fi
VIRTUAL_OUT=""; TARGET_WS=""
hypr_exec() { hyprctl repl "return hl.dispatch(hl.dsp.exec_cmd(\"$1\"))" >/dev/null 2>&1; }

make_virtual_output() {
  QUILL_MONS_BEFORE=$(hyprctl monitors -j | python3 -c "import json,sys;print(' '.join(m['name'] for m in json.load(sys.stdin)))")
  export QUILL_MONS_BEFORE
  hyprctl output create headless >/dev/null 2>&1 || return 1
  sleep 0.5
  VIRTUAL_OUT=$(hyprctl monitors -j | python3 -c "import json,sys,os
have=set(os.environ.get('QUILL_MONS_BEFORE','').split())
new=[m['name'] for m in json.load(sys.stdin) if m['name'] not in have]
print(new[0] if new else '')")
  [ -n "$VIRTUAL_OUT" ] || return 1
  export QUILL_VOUT="$VIRTUAL_OUT"
  TARGET_WS=$(hyprctl monitors -j | python3 -c "import json,sys,os
for m in json.load(sys.stdin):
    if m['name'] == os.environ['QUILL_VOUT']: print(m['activeWorkspace']['id'])")
  [ -n "$TARGET_WS" ]
}
drop_virtual_output() { if [ -n "$VIRTUAL_OUT" ]; then hyprctl output remove "$VIRTUAL_OUT" >/dev/null 2>&1 || true; fi; VIRTUAL_OUT=""; }

trap 'drop_virtual_output' EXIT INT TERM
case "$place" in
  virtual)
    if [ "$have_hypr" = 1 ] && make_virtual_output; then
      echo "quill: measuring on virtual output $VIRTUAL_OUT (workspace $TARGET_WS) — nothing is shown on the physical screen" >&2
    else
      echo "quill: could not create a virtual output; refusing to open a window on the user's screen." >&2
      echo "       Use --ws N for a free workspace, --here with QUILL_HEADED_OK=1, or measure headless" >&2
      echo "       with: node legacy/tools/latency.mjs" >&2
      exit 3
    fi ;;
  workspace)
    [ "$have_hypr" = 1 ] || { echo "quill: --ws needs hyprctl" >&2; exit 3; }
    TARGET_WS="$ws"
    active=$(hyprctl activeworkspace -j | python3 -c "import json,sys;print(json.load(sys.stdin)['id'])")
    if [ "$TARGET_WS" = "$active" ]; then echo "quill: workspace $ws is the one in use — refusing" >&2; exit 3; fi ;;
  panel)
    # The one measurement a virtual output cannot give: commit -> scan-out on the real panel.
    # A surface on a workspace nobody is looking at gets no frame callbacks, so the window has to
    # be genuinely on screen. BRIEF.md forbids doing that to somebody who is working, so this
    # refuses unless every real keyboard and pointer on the machine has been silent, and it puts
    # the workspace that was up back when it is done.
    [ "$have_hypr" = 1 ] || { echo "quill: --panel needs hyprctl" >&2; exit 3; }
    # Is there a physical panel at all? When every real output is asleep (a DisplayPort monitor in
    # standby drops the link) Hyprland substitutes a headless output called FALLBACK, and measuring
    # scan-out on that is exactly the thing this mode exists to avoid.
    real=$(hyprctl monitors -j | python3 -c "import json,sys;print(sum(1 for m in json.load(sys.stdin) if not m['name'].startswith(('HEADLESS','FALLBACK'))))")
    [ "$real" -ge 1 ] || { echo "quill: no physical output is connected (Hyprland is on FALLBACK — the panel is asleep). Nothing to measure scan-out on." >&2; exit 7; }
    TARGET_WS="$ws"
    ORIG_WS=$(hyprctl activeworkspace -j | python3 -c "import json,sys;print(json.load(sys.stdin)['id'])")
    [ "$TARGET_WS" != "$ORIG_WS" ] || { echo "quill: workspace $ws is the one in use — refusing" >&2; exit 3; }
    [ "$TARGET_WS" != "1" ] || { echo "quill: workspace 1 is the user's — refusing" >&2; exit 3; }
    if ! python3 "$REPO/tools/idle-check.py" "$idle_window"; then
      echo "quill: somebody is using this machine — not taking the screen. Try again when it is idle," >&2
      echo "       or measure on a virtual output with --virtual (no panel scan-out in that number)." >&2
      exit 4
    fi
    # Hyprland 0.56 dropped the old string dispatcher: `hyprctl dispatch workspace N` now returns
    # a Lua parse error (exit 7) and changes nothing, which would leave the window on a workspace
    # nobody is looking at — i.e. exactly the unpresented surface this mode exists to avoid. The
    # Lua form is hl.dispatch(hl.dsp.focus{workspace=N}), and the switch is read back to prove it.
    goto_ws() { hyprctl repl "return hl.dispatch(hl.dsp.focus{workspace=$1})" >/dev/null 2>&1 || true; }
    read_ws() { hyprctl activeworkspace -j | python3 -c "import json,sys;print(json.load(sys.stdin)['id'])"; }
    restore_ws() { goto_ws "$ORIG_WS"; }
    trap 'restore_ws; drop_virtual_output' EXIT INT TERM
    goto_ws "$TARGET_WS"; sleep 0.4
    if [ "$(read_ws)" != "$TARGET_WS" ]; then
      echo "quill: could not bring workspace $TARGET_WS up on the panel — refusing to measure a window nobody is looking at." >&2
      echo "       Hyprland 0.56.2's Lua dispatcher has no workspace-switch binding this script could find:" >&2
      echo "       hl.dsp.workspace is a table of {move, change_id, rename, toggle_special, swap_monitors} and" >&2
      echo "       hl.focus accepts only {direction, monitor, window, urgent_or_last, last}. The old text form" >&2
      echo "       'dispatch workspace N' is gone (it is parsed as Lua and fails), over hyprctl and over the" >&2
      echo "       IPC socket alike. Until that is solved, use --virtual and read the caveat in the report." >&2
      exit 6
    fi
    echo "quill: measuring on the PHYSICAL panel, workspace $TARGET_WS (was $ORIG_WS); it goes back afterwards" >&2 ;;
  here)
    [ "${QUILL_HEADED_OK:-0}" = "1" ] || { echo "quill: --here opens a window on the active workspace; set QUILL_HEADED_OK=1 if that is really wanted" >&2; exit 3; } ;;
esac

# --- measured launches -------------------------------------------------------
results=()
for run in $(seq 1 "$runs"); do
  DBG=$((9300 + RANDOM % 400))
  if [ "$fresh" = 1 ] && [ "$run" -gt 1 ]; then wipe_profile; fi
  cmd="$CHROME"
  for f in "${FLAGS[@]}" --remote-debugging-port="$DBG"; do cmd="$cmd $f"; done
  pid=""
  if [ -n "$TARGET_WS" ]; then
    t0=$(date +%s%3N)                                 # wall clock, ms, immediately before exec
    hypr_exec "[workspace $TARGET_WS silent] $cmd"
  else
    t0=$(date +%s%3N)
    "$CHROME" "${FLAGS[@]}" --remote-debugging-port="$DBG" >/dev/null 2>&1 &
    pid=$!
  fi
  for _ in $(seq 1 600); do curl -sf -o /dev/null "http://127.0.0.1:$DBG/json/version" && break; sleep 0.02; done
  # Real keys go wherever the COMPOSITOR thinks focus is. Before injecting any, the Quill window
  # has to hold keyboard focus — on the panel, and just as much on a virtual output, where the
  # alternative is somebody's terminal. Hyprland 0.56's Lua dispatcher has no string form, so this
  # tries the forms that exist, then READS BACK the active window and refuses unless it is Quill.
  # legacy/tools/latency.mjs then refuses a second time unless the page itself reports document.hasFocus()
  # with the caret in the textarea. Two independent guards, and the second one is the authority:
  # a Wayland client only reports focus if the compositor sent it keyboard enter.
  # Chromium's --app windows take their Wayland app_id from the URL, not from --class, so the
  # window cannot be found by class. It is the one on the workspace this run created, and on a
  # virtual output it is the only thing there.
  focus_quill() {
    local addr act
    addr=$(QW="$TARGET_WS" python3 -c "import json,os,subprocess,sys
cs=json.loads(subprocess.check_output(['hyprctl','clients','-j']))
ws=int(os.environ['QW'])
m=[c for c in cs if c['workspace']['id']==ws]
print(m[0]['address'] if m else '')")
    [ -n "$addr" ] || return 1
    act=$(python3 -c "import json,subprocess
try: print(json.loads(subprocess.check_output(['hyprctl','activewindow','-j'])).get('address',''))
except Exception: print('')")
    if [ "$act" != "$addr" ]; then
      hyprctl repl "return hl.dispatch(hl.dsp.focus{monitor=hl.get_monitor(\"${VIRTUAL_OUT:-}\")})" >/dev/null 2>&1 || true
      sleep 0.35
      act=$(python3 -c "import json,subprocess
try: print(json.loads(subprocess.check_output(['hyprctl','activewindow','-j'])).get('address',''))
except Exception: print('')")
    fi
    [ "$act" = "$addr" ]
  }
  if [ "$place" = "panel" ] || [ "$uinput" = 1 ]; then
    sleep 0.4
    if ! focus_quill; then
      if [ "$uinput" = 1 ]; then
        echo "quill: could not give the Quill window keyboard focus — refusing to inject real keys," >&2
        echo "       they would go to whatever is focused instead. Nothing was typed." >&2
        pkill -f -- "--remote-debugging-port=$DBG" 2>/dev/null || true
        exit 5
      fi
    fi
  fi

  # --url matters: latency.mjs RELOADS the window for each regime, and without it the reload goes
  # to the default port instead of to whatever this launcher opened (a frozen snapshot, usually).
  argv=( --attach "$DBG" --t0 "$t0" --url "$URL" --profile "$PROFILE" --where "${VIRTUAL_OUT:-workspace $TARGET_WS}" )
  if [ -n "$snapshot" ]; then argv+=( --snapshot "$snapshot" ); fi
  if [ "$rmotion" = 1 ]; then argv+=( --reduced-motion ); fi
  if [ -n "$clock" ]; then argv+=( --clock "$clock" ); fi
  if [ "$uinput" = 1 ]; then argv+=( --uinput ); fi
  if [ "$run" = "$runs" ] && [ "$keys" != 0 ]; then
    argv+=( --keys "$keys" --sessions "$sessions" )
    if [ -n "$regimes" ]; then argv+=( --regimes "$regimes" ); fi
    if [ -n "$throttle" ]; then argv+=( --throttle "$throttle" ); fi
  else
    argv+=( --keys 0 )
  fi
  if [ -n "$doc" ]; then argv+=( --doc "$doc" ); fi
  if [ "$seed" = 1 ] && [ "$run" = "$runs" ]; then argv+=( --seed ); fi
  if [ -n "$out" ]; then
    node "$ROOT/tools/latency.mjs" "${argv[@]}" --json "${out%.json}-$run.json" --quiet || true
    results+=( "${out%.json}-$run.json" )
  else
    node "$ROOT/tools/latency.mjs" "${argv[@]}" || true
  fi

  if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
  else pkill -f -- "--remote-debugging-port=$DBG" 2>/dev/null || true; fi
  sleep 0.6
done
if [ ${#results[@]} -gt 0 ]; then echo "quill: wrote ${results[*]}" >&2; fi

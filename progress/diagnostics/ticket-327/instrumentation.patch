@@ -47,6 +47,64 @@ use gtk::gdk;
 use gtk::glib;
 use gtk::prelude::*;
 
+// DEBUG-327: temporary observations; never used by measurement acceptance.
+thread_local! {
+    static PROBE: RefCell<Option<Probe>> = const { RefCell::new(None) };
+}
+
+struct Probe {
+    file: File,
+    lines: String,
+    watches: Vec<(gdk::FrameTimings, i64)>,
+}
+
+pub(crate) struct ProbeStage(&'static str, i64);
+
+pub(crate) fn probe_stage(name: &'static str) -> ProbeStage {
+    ProbeStage(name, glib::monotonic_time())
+}
+
+impl Drop for ProbeStage {
+    fn drop(&mut self) {
+        let end = glib::monotonic_time();
+        PROBE.with_borrow_mut(|held| {
+            if let Some(p) = held {
+                p.lines.push_str(&format!("{{\"kind\":\"stage\",\"name\":\"{}\",\"start_us\":{},\"end_us\":{end}}}\n", self.0, self.1));
+            }
+        });
+    }
+}
+
+fn probe_observe(t: &gdk::FrameTimings, consumer: &str) {
+    let before = glib::monotonic_time();
+    let present = t.presentation_time();
+    let complete = t.is_complete();
+    let after = glib::monotonic_time();
+    PROBE.with_borrow_mut(|held| {
+        if let Some(p) = held {
+            p.lines.push_str(&format!("{{\"kind\":\"accept\",\"consumer\":\"{consumer}\",\"frame\":{},\"before_us\":{before},\"after_us\":{after},\"complete\":{complete},\"present_us\":{present}}}\n", t.frame_counter()));
+            p.watches.push((t.clone(), after));
+        }
+    });
+}
+
+fn probe_drain() {
+    PROBE.with_borrow_mut(|held| {
+        if let Some(p) = held {
+            p.watches.retain(|(t, accepted)| {
+                let before = glib::monotonic_time();
+                let present = t.presentation_time();
+                let complete = t.is_complete();
+                let after = glib::monotonic_time();
+                p.lines.push_str(&format!("{{\"kind\":\"reread\",\"frame\":{},\"accepted_us\":{accepted},\"before_us\":{before},\"after_us\":{after},\"complete\":{complete},\"present_us\":{present}}}\n", t.frame_counter()));
+                after - accepted < 500_000
+            });
+            let _ = p.file.write_all(p.lines.as_bytes());
+            p.lines.clear();
+        }
+    });
+}
+

#!/usr/bin/env bash
# The Gate, in commands — what must be true before native Quill work lands.
# The tiers themselves are docs/agents/gate.md; this is how they are run.
#
#   tools/gate check              the Commit tier on the repo root
#   tools/gate check <dir>        ... on another directory (the fixture beside it)
#
# The owner does not read Rust, so every command here ends in one line the owner
# can read without opening the code: `gate check: pass`, or `gate check: fail
# (<step>)` naming the step that stopped it. The exit code agrees with the line.
#
# `check` runs the Commit tier's steps in the order they get cheaper to fix, and
# stops at the first failure:
#
#   fmt      cargo fmt --check
#   allow    every #[allow(...)] carries its reason as a comment on its own line
#   clippy   cargo clippy --all-targets -- -D warnings, on the default lint set
#   test     cargo test, with DISPLAY and WAYLAND_DISPLAY unset
#
# The display is unset rather than merely absent, so a test that needs a window
# fails here whatever session runs it. That is what makes such a test harness
# rather than test: it belongs to a later sub-command, not to `cargo test`.
#
# The step output is not captured — cargo says where the failure is, and the
# agent that has to fix it reads that, above the line the owner reads.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

usage() {
    cat <<'EOF'
usage: tools/gate <command> [arguments]

  check [dir]   The Commit tier in one command: cargo fmt --check, the #[allow]
                reason rule, cargo clippy --all-targets -- -D warnings, and
                cargo test with no display attached, in that order, stopping at
                the first failure. Runs on the repo root, or on <dir> if one is
                given. Ends in `gate check: pass` or `gate check: fail (<step>)`.

The tiers these commands serve are docs/agents/gate.md.
EOF
}

# The step about to run, named, with the command it stands for.
step() { printf 'gate check: %s (%s)\n' "$1" "$2"; }

# The last line, and the exit code that agrees with it.
fail() { printf 'gate check: fail (%s)\n' "$1"; exit 1; }

# The directories of the packages of the workspace being checked, from cargo
# itself, so `check <dir>` sees that directory's crates and no others.
package_dirs() {
    cargo metadata --no-deps --format-version 1 |
        python3 -c 'import json, os, sys
for package in json.load(sys.stdin)["packages"]:
    print(os.path.dirname(package["manifest_path"]))'
}

# Every Rust file cargo compiles in those packages. Not a `find` over the whole
# directory: a crate may keep Rust that is not part of it (the fixture keeps its
# defects that way), and `target/` is full of other people's.
sources() {
    local package part; local -a where
    while IFS= read -r package; do
        where=()
        for part in src tests benches examples build.rs; do
            [ -e "$package/$part" ] && where+=("$package/$part")
        done
        [ ${#where[@]} -gt 0 ] && find "${where[@]}" -type f -name '*.rs'
    done < <(package_dirs)
}

# docs/agents/gate.md: an #[allow(...)] carries a one-line reason on the same
# line. Checked here rather than remembered, and named by file and line.
allow_reasons() {
    local file lineno line; local -a bare=()
    while IFS= read -r file; do
        while IFS=: read -r lineno line; do
            # The reason is a comment on the attribute's own line. A `///` or
            # `//!` line quoting the attribute carries one by construction.
            case "$line" in *'//'*) continue ;; esac
            bare+=("${file#"$PWD"/}:$lineno:${line#"${line%%[![:space:]]*}"}")
        done < <(grep -nE '#!?\[allow\(' "$file" || true)
    done < <(sources)
    [ ${#bare[@]} -eq 0 ] && return 0
    printf '%s\n' "${bare[@]}"
    echo "an #[allow(...)] carries its reason as a comment on the same line (docs/agents/gate.md)"
    return 1
}

check() {
    local dir=${1:-$ROOT}
    if [ ! -f "$dir/Cargo.toml" ]; then
        echo "gate: $dir: no Cargo.toml to check" >&2
        exit 2
    fi
    cd "$dir"

    step fmt "cargo fmt --check"
    cargo fmt --check || fail fmt

    step allow "#[allow(...)] carries its reason on the same line"
    allow_reasons || fail allow

    step clippy "cargo clippy --all-targets -- -D warnings"
    cargo clippy --all-targets -- -D warnings || fail clippy

    step test "cargo test, with no display attached"
    env -u DISPLAY -u WAYLAND_DISPLAY cargo test || fail test

    echo "gate check: pass"
}

case "${1-}" in
    check) shift; check "$@" ;;
    -h | --help | help) usage ;;
    "") usage >&2; exit 2 ;;
    *) echo "gate: ${1}: not a command this Gate has yet" >&2; usage >&2; exit 2 ;;
esac

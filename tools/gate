#!/usr/bin/env bash
# The Gate, in commands — what must be true before native Quill work lands.
# The tiers themselves are docs/agents/gate.md; this is how they are run.
#
#   tools/gate check              the Commit tier, on the repo root
#   tools/gate check <dir>        ... on another directory
#   tools/gate oracle <piece>     freeze the Parity oracle's shots for one Piece
#   tools/gate bench [regime]     type a regime with real keys and time it against the budget
#   tools/gate bench --panel      ... on the physical display, informational, only while idle
#   tools/gate judge <piece>      shoot ours, pair it blind, judge it, record the round
#   tools/gate keys <piece>       type real keys into ours, then read the assertions off the pixels
#   tools/gate --help             the commands there are, and what each runs
#
# The owner does not read Rust, so every command here ends in one line the owner
# can read without opening the code: `gate check: pass`, or `gate check: fail
# (<step>)` naming the step that stopped it. The exit code agrees with the line.
#
# `check`'s steps run cheapest first, so a red line arrives as early as it can,
# and it stops at the first one. The display is unset rather than merely absent
# for the test step, so a test that needs a window fails here whatever session
# runs it: that is what makes such a test harness rather than test, and it
# belongs to a later sub-command. DISPLAY, WAYLAND_DISPLAY and WAYLAND_SOCKET
# are the three ways a client finds a display.
#
# Every step's output is captured to `target/gate/<step>.log`, under whichever
# directory is being checked, and printed only for the step that fails — above
# the line the owner reads, so the agent that has to fix it still gets cargo's
# own words. A green run is its step lines and its last line and nothing else:
# the test list grows with every Piece, and an agent pays for all of it.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

# The one copy of what the commands are; the header above says why.
usage() {
    cat <<'EOF'
usage: tools/gate <command> [arguments]

  check [dir]   The Commit tier in one command: cargo fmt --check, the #[allow]
                reason rule, cargo clippy --all-targets -- -D warnings, cargo
                test with no display attached, and — on the repo root only —
                the bench join's own tests and the typed condition's, in that
                order, stopping at the first failure. Each step's output goes to
                target/gate/<step>.log and is printed only if that step is the
                one that fails. Runs on the repo root, or on <dir> if one is
                given — which is how tools/gate-fixture/selftest points it at a
                crate whose defects it must go red on. Ends in `gate check:
                pass` or `gate check: fail (<step>)`.

  oracle <piece> [--force]
                Freezes the Parity oracle for one Piece: the app in legacy/ shot
                at every state shots/oracle/states.json lists for it, into
                shots/oracle/<piece>/<state>.png with the fingerprint of what
                produced them beside. Shoots nothing when those shots are
                already the ones it would take; --force shoots them anyway.
                Ends in `gate oracle <piece>: froze N states (<why>)`,
                `... unchanged`, or `... fail (...)`.

  bench [regime] [--all] [--regimes a,b] [--keys N] [--sessions N]
        [--panel] [--idle-window S]
                The Ticket tier's latency Piece, measured rather than judged:
                ours built and launched on the 10k-word document with the caret
                at the end of it, on a headless output of the Gate's own, and
                the regime typed into it with real keys through /dev/uinput —
                prose_end_of_draft at 133 wpm unless another of the twelve is
                named. Focus is read back from the compositor before the first
                key and between every chunk of 25, and a run that cannot prove
                the keys will land on ours types none of them. The measurement
                is the uinput write(2) to the presentation time GdkFrameTimings
                gives for the frame carrying that key. The result, with its
                accounting and the fingerprint of what produced it, is written
                to shots/latency/bench-<regime>-<stamp>.json. Ends in `gate
                bench <regime>: pass|fail (budget ...; oracle ...)`: 0 for pass,
                1 for a budget miss, 3 when there is no verdict to give —
                nothing measured, focus lost part-way, or a regime whose
                keystrokes did not add up, however many others ran. Those three
                lines are the whole of stdout; everything said on the way there
                is target/gate/bench.log, printed when the run refuses.
                --all runs every one of the twelve and --regimes just the named
                ones, each with its own launch, its own caret and Focus, and its
                own result file; a run of several says one line per regime and
                then one line for the run, which is pass only when every regime
                in it cleared the budget, and writes what those lines say to
                shots/latency/summary-<stamp>.json. A regime name, --all and
                --regimes each say which regimes to run, so only one may be
                given.
                --panel measures on the physical display instead — the one
                number a headless output cannot give, keyboard to a vblank-gated
                presentation on the panel the owner actually reads. It composes
                with --all and --regimes, and it takes the screen for the run:
                the window goes on workspace 5, which is brought up on the panel
                because a surface nobody is displaying gets no frame callbacks,
                and the workspace that was up goes back on exit, on error and on
                Ctrl-C. Before it creates or shows anything it refuses when
                somebody is at the machine (every real keyboard and pointer
                silent for --idle-window seconds, 8 by default, through
                tools/idle-check.py), when no physical output is connected
                (Hyprland on FALLBACK, the panel asleep) and when workspace 5 is
                the one in use. The result is informational and never a Gate
                condition: the panel is fractional-scale, so its numbers are not
                the headless output's and are not held against the budget. Every
                line says so and names the output, mode and scale; results
                are bench-panel-<regime>-<stamp>.json, marked informational
                inside, and a run of several also writes
                shots/latency/panel-summary-<stamp>.json, which `judge latency`
                does not read and refuses if it is handed one.

  judge <piece> [--note <text>] [--summary <file>] [--settings <path>]
                The Ticket tier's blind judging for one Piece: ours built and
                shot at every judged state on a headless output of the Gate's
                own, each shot paired with the frozen Parity oracle under
                shots/blind/<piece>/<state>/ (the key goes to
                $XDG_STATE_HOME/quill/blind-keys/), one fresh critic per pair,
                revealed, and written to progress/rounds/<piece>-r<N>.json.
                --note records what changed this round. The Piece is ours only
                when every state is. Ends in `gate judge <piece>: ours|theirs,
                round <N>`: 0 for ours, 1 for theirs, 2 for theirs after this
                Piece had been won, 3 when nothing was judged — a command line
                it could not read included, since 2 is spoken for. That line,
                with the one above it that names the round which won a Piece now
                lost, is the whole of stdout: everything said on the way there is
                target/gate/judge-<piece>.log, printed when the run refuses, and
                a round that reached a verdict has its detail in the JSON.
                latency is the one Piece with no picture to look at, so it is
                judged by arithmetic instead: it reads the newest whole run
                under shots/latency/, or the one --summary names, and is ours
                when every regime cleared the budget and prose_end_of_draft beat
                the oracle's own keystroke and cold-start numbers. Same round
                file, same line, same four exit codes.
                --settings opens ours with that settings file and reaches ours
                alone: the Parity oracle has no such file, and its shots were
                frozen before the round began. The round's build names the
                path, so a round shot against a rebinding fixture says so.
                latency shoots nothing, and refuses the flag rather than take
                it and record a file that never touched the numbers.

  keys <piece> [--shots <dir>]
                The Ticket tier's condition that types: ours built and opened
                Live — not --deterministic, because the caret machine is what a
                typed condition tests — on a headless output of the Gate's own,
                keyboard focus taken and proved, then the Piece's scripted
                bursts written through /dev/uinput with focus asked again
                between every chunk, and after each burst a capture the Piece's
                assertions are read off. The pixels decide and the app is never
                asked: on #108 the app believed its own caret was at x=0, so a
                probe would have agreed with the defect in good faith. The
                scripts are the `keys` entries of shots/oracle/states.json,
                beside the judged states, and a Piece may carry none. --shots
                keeps each burst's capture as well, which is how the fixtures
                under tools/keys-fixture were taken. Ends in `gate keys <piece>:
                pass` or `gate keys <piece>: fail (<the assertion, measured
                against what it expected>)`: 0 for pass, 1 for fail, and 3 with
                `gate keys <piece>: refused (...)` when nothing was typed or
                nothing could be read — no script for that Piece, no compositor,
                a binary that would not build, or focus taken away mid-run.
                Everything said on the way is target/gate/keys-<piece>.log,
                printed when the run refuses.

The tiers these commands serve are docs/agents/gate.md.
EOF
}

# The step about to run, named, with the command it stands for.
step() { printf 'gate check: %s (%s)\n' "$1" "$2"; }

# The last line, and the exit code that agrees with it.
fail() { printf 'gate check: fail (%s)\n' "$1"; exit 1; }

# One step: its line, then its command with every word of its output — cargo's
# and this script's alike — held in the step's log. A green step is its line and
# nothing more; a red one hands the log over before the line the owner reads.
# The log sits where the build output does, under the directory being checked,
# so a check on the fixture leaves nothing behind in the repo.
run_step() {
    local name=$1 what=$2 log=$PWD/target/gate/$1.log; shift 2
    step "$name" "$what"
    mkdir -p "$(dirname "$log")"
    "$@" > "$log" 2>&1 || { cat "$log"; fail "$name"; }
}

# Every Rust file cargo compiles in the workspace being checked, from cargo's
# own idea of it. The directories come from the packages' targets rather than
# from a list of names kept here, so a crate that keeps its sources somewhere
# unusual is still read — and a crate that keeps Rust which is *not* part of it
# (the fixture keeps its defects that way) does not have that read as its own.
sources() {
    local metadata; local -a where=()
    metadata=$(cargo metadata --no-deps --format-version 1)
    mapfile -t where < <(printf '%s' "$metadata" | python3 -c '
import json, os, sys

where = []
for package in json.load(sys.stdin)["packages"]:
    root = os.path.dirname(package["manifest_path"])
    for target in package["targets"]:
        # A target at the top of the package (build.rs) is itself; anything
        # deeper stands for the directory it lives in, modules and all.
        source = target["src_path"]
        where.append(source if os.path.dirname(source) == root else os.path.dirname(source))
for path in sorted(set(where)):
    print(path)')
    [ ${#where[@]} -gt 0 ] || { echo "gate: cargo metadata named no sources to read" >&2; return 1; }
    find "${where[@]}" -type f -name '*.rs' -not -path '*/target/*'
}

# docs/agents/gate.md: an #[allow(...)] carries a one-line reason on the same
# line. Checked here rather than remembered, and named by file and line. A step
# that read nothing is a failure, not a pass: silence has to mean silence.
allow_reasons() {
    local found status file lineno line; local -a files=() bare=()
    mapfile -t files < <(sources)
    [ ${#files[@]} -gt 0 ] || { echo "gate: no Rust to read" >&2; return 1; }

    # grep says 1 for "nothing matched", which is the good news here; anything
    # above that is grep failing, and a failure must not read as clean.
    # `/dev/null` keeps the file name on the line when there is one file.
    found=$(grep -nE '#!?\[allow\(' "${files[@]}" /dev/null) && status=0 || status=$?
    [ "$status" -le 1 ] || { echo "gate: could not read the sources" >&2; return 1; }

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        file=${line%%:*}; line=${line#*:}
        lineno=${line%%:*}; line=${line#*:}
        # The reason is a comment with something in it, on the attribute's own
        # line. A `///` or `//!` line quoting the attribute carries one by
        # construction.
        case "$line" in *'//'*[![:space:]]*) continue ;; esac
        bare+=("${file#"$PWD"/}:$lineno:${line#"${line%%[![:space:]]*}"}")
    done <<< "$found"

    [ ${#bare[@]} -eq 0 ] && return 0
    printf '%s\n' "${bare[@]}"
    echo "an #[allow(...)] carries its reason as a comment on the same line (docs/agents/gate.md)"
    return 1
}

check() {
    local dir=${1:-$ROOT}
    if [ ! -f "$dir/Cargo.toml" ]; then
        echo "gate: $dir: no Cargo.toml to check" >&2
        exit 2
    fi
    cd "$dir"

    run_step fmt "cargo fmt --check" \
        cargo fmt --check
    run_step allow "#[allow(...)] carries its reason on the same line" \
        allow_reasons
    run_step clippy "cargo clippy --all-targets -- -D warnings" \
        cargo clippy --all-targets -- -D warnings
    run_step test "cargo test, with no display attached" \
        env -u DISPLAY -u WAYLAND_DISPLAY -u WAYLAND_SOCKET cargo test
    # Last, and only when the directory being checked is this repository: the
    # bench's join is the one part of the Gate's own tooling that decides what a
    # number means, and it is a pure function of two files, so it is checked on
    # every commit alongside the Rust. Skipped for a `check <dir>` elsewhere,
    # because a step that can only go red for a reason outside <dir> would make
    # `gate check <dir>` mean something other than "this directory is sound" —
    # which is exactly what tools/gate-fixture/selftest points it at.
    if [ "$PWD" = "$ROOT" ]; then
        run_step bench "node tools/bench-selftest.mjs" \
            node "$ROOT/tools/bench-selftest.mjs"
        # The typed condition's assertion, over the two builds committed as pixels under
        # tools/keys-fixture: green on the build that follows the writing, red on the one that
        # does not. It runs here, on every commit, for the same reason the bench's does — it is a
        # pure function of a decoded PNG, it needs no window, and the defect it exists to catch is
        # one that three judged states and six critics let through (#108, #138).
        run_step keys "node tools/keys-selftest.mjs" \
            node "$ROOT/tools/keys-selftest.mjs"
        # The two halves of a blind pair: which states are shot and frozen, and
        # which opponent each is paired with — the Parity oracle's frozen shot,
        # or the crop of a mac-native capture the state names (ADR 0015). Both
        # are pure functions of shots/oracle/states.json and files on disk, they
        # need no window, no browser and no critic, and between them they hold
        # the arithmetic that decides what a critic is shown.
        run_step oracle "node tools/oracle-selftest.mjs" \
            node "$ROOT/tools/oracle-selftest.mjs"
        run_step judge "node tools/judge-selftest.mjs" \
            node "$ROOT/tools/judge-selftest.mjs"
    fi

    echo "gate check: pass"
}

case "${1-}" in
    check) shift; check "$@" ;;
    # The oracle reads a JSON state file, converts offsets and drives a browser
    # through legacy/tools/shoot.mjs, so it is Node; the line it ends in is its
    # own, in the shape the header above asks of every command here.
    oracle) shift; exec node "$ROOT/tools/oracle.mjs" "$@" ;;
    # The bench drives the compositor, a binary and /dev/uinput, and reads the
    # twelve regimes out of tools/regimes.mjs; it is Node for the same reason
    # the oracle is, and ends in its own line in the same shape.
    bench) shift; exec node "$ROOT/tools/bench.mjs" "$@" ;;
    # Judging drives the compositor, a binary and a critic session, and its exit
    # code is the verdict rather than pass or fail; it is Node for the same
    # reason the oracle is, and ends in its own line in the same shape.
    judge) shift; exec node "$ROOT/tools/judge.mjs" "$@" ;;
    # The one condition that types and then looks: it drives the compositor, a
    # binary and /dev/uinput as the bench does, and reads the pixels as judging
    # does. Node for the same reason, and ends in its own line in the same shape.
    keys) shift; exec node "$ROOT/tools/keys.mjs" "$@" ;;
    -h | --help | help) usage ;;
    "") usage >&2; exit 2 ;;
    *) echo "gate: ${1}: not a command this Gate has yet" >&2; usage >&2; exit 2 ;;
esac

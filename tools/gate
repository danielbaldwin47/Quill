#!/usr/bin/env bash
# The Gate, in commands — what must be true before native Quill work lands.
# The tiers themselves are docs/agents/gate.md; this is how they are run.
#
#   tools/gate check              the Commit tier, on the repo root
#   tools/gate check <dir>        ... on another directory
#   tools/gate oracle <piece>     freeze the Parity oracle's shots for one Piece
#   tools/gate bench [regime]     type a regime with real keys and time it against the budget
#   tools/gate bench --panel      ... on the physical display, informational, only while idle
#   tools/gate shoot <piece>      shoot ours as judge would, and say whether the pixels moved; no critic
#   tools/gate judge <piece>      shoot ours, pair it blind, judge it, record the round
#   tools/gate keys <piece>       type real keys into ours, then read the assertions off the pixels
#   tools/gate --help             the commands there are, and what each runs
#
# The owner does not read Rust, so every command here ends in one line the owner
# can read without opening the code: `gate check: pass`, or `gate check: fail
# (<step>)` naming the step that stopped it. The exit code agrees with the line.
#
# `check`'s steps run cheapest first, so a red line arrives as early as it can,
# and it stops at the first one. The display is unset rather than merely absent
# for the test step, so a test that needs a window fails here whatever session
# runs it: that is what makes such a test harness rather than test, and it
# belongs to a later sub-command. DISPLAY, WAYLAND_DISPLAY and WAYLAND_SOCKET
# are the three ways a client finds a display.
#
# Every step's output is captured to `target/gate/<step>.log`, under whichever
# directory is being checked, and printed only for the step that fails — above
# the line the owner reads, so the agent that has to fix it still gets cargo's
# own words. A green run is its step lines and its last line and nothing else:
# the test list grows with every Piece, and an agent pays for all of it.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

# The one copy of what the commands are; the header above says why.
usage() {
    cat <<'EOF'
usage: tools/gate <command> [arguments]

  check [dir]   The Commit tier in one command: cargo fmt, applied — the step
                line names any file it changed, and the change is the
                session's to commit — the #[allow] reason rule, the rounding
                rule (round: a float becomes an integer only in a helper the
                ROUND_ONCE list in this script names), and — on the repo root
                only — the citation rule (cite: every ADR NNNN, NOTES §,
                VERDICTS § and design.md row cited in docs/design.md,
                progress/state.json and shots/oracle/states.json resolves)
                and the canonical-JSON rule (json: those two JSON files are
                Node's JSON.stringify(v, null, 2) byte for byte), then cargo
                clippy --all-targets -- -D warnings, cargo test with no display
                attached, and — on the repo root only — every
                tools/*-selftest.mjs in name order, none of which needs a
                window: the bench join's, the two the blind pair is decided
                by (the judge's and the oracle's, with the typed condition's
                between), and this help's own (usage-selftest, which holds it
                to the subcommands dispatched below and the endings their
                scripts print). In that order, stopping at the first failure. Each step's output goes to
                target/gate/<step>.log and is printed only if that step is the
                one that fails. Runs on the repo root, or on <dir> if one is
                given — which is how tools/gate-fixture/selftest points it at a
                crate whose defects it must go red on. Ends in `gate check:
                pass` or `gate check: fail (<step>)`.

  oracle <piece> [--force]
                Freezes the Parity oracle for one Piece: the app in legacy/ shot
                at every state shots/oracle/states.json lists for it, into
                shots/oracle/<piece>/<state>.png with the fingerprint of what
                produced them beside. Shoots nothing when those shots are
                already the ones it would take; --force shoots them anyway. A
                state with no Parity opponent is not this command's to freeze
                and is passed over: one naming a mac-native crop, and one
                carrying `assert`, which is measured off ours' own pixels. A
                Piece whose every state does that is finished before a browser
                starts.
                Ends in `gate oracle <piece>: froze N states (<why>)`,
                `... unchanged`, `... nothing to freeze (...)`,
                `... no judged states (...)`, or `... fail (...)`.

  bench [regime] [--all] [--regimes a,b] [--keys N] [--sessions N]
        [--panel] [--idle-window S]
                The Ticket tier's latency Piece, measured rather than judged:
                ours built and launched on the 10k-word document with the caret
                at the end of it, on a headless output of the Gate's own, and
                the regime typed into it with real keys through /dev/uinput —
                prose_end_of_draft at 133 wpm unless another of the fifteen is
                named. Focus is read back from the compositor before the first
                key and between every chunk of 25, and a run that cannot prove
                the keys will land on ours types none of them. The measurement
                is the uinput write(2) to the presentation time GdkFrameTimings
                gives for the frame carrying that key. The result, with its
                accounting and the fingerprint of what produced it, is written
                to shots/latency/bench-<regime>-<stamp>.json. Ends in `gate
                bench <regime>: pass|fail (budget ...; oracle ...)`: 0 for pass,
                1 for a budget miss, and 3 with `gate bench: refused (...)`
                when there is no verdict to give — nothing measured, focus
                lost part-way, or a regime whose keystrokes did not add up,
                however many others ran. Those three
                lines are the whole of stdout; everything said on the way there
                is target/gate/bench.log, printed when the run refuses.
                --all runs every one of the fifteen and --regimes just the named
                ones, each with its own launch, its own caret and Focus, and its
                own result file; a run of several says one line per regime and
                then one line for the run, which is pass only when every scored
                regime in it cleared the budget, and writes what those lines say
                to shots/latency/summary-<stamp>.json. tools/regimes.mjs marks
                which regimes are scored (scored: false) and why; one that is
                not still runs, is recorded and must account for its keys, and
                its lines say informational rather than pass or fail. A regime
                that cannot account for its keys stops the run there, refuses
                it, and keeps the keys as sent and the stamps as written beside
                its result, as bench-<regime>-<stamp>.capture.json. A regime
                name, --all and
                --regimes each say which regimes to run, so only one may be
                given.
                --panel measures on the physical display instead — the one
                number a headless output cannot give, keyboard to a vblank-gated
                presentation on the panel the owner actually reads. It composes
                with --all and --regimes, and it takes the screen for the run:
                the window goes on workspace 5, which is brought up on the panel
                because a surface nobody is displaying gets no frame callbacks,
                and the workspace that was up goes back on exit, on error and on
                Ctrl-C. Before it creates or shows anything it refuses when
                somebody is at the machine (every real keyboard and pointer
                silent for --idle-window seconds, 8 by default, through
                tools/idle-check.py), when no physical output is connected
                (Hyprland on FALLBACK, the panel asleep) and when workspace 5 is
                the one in use. The result is informational and never a Gate
                condition: the panel is fractional-scale, so its numbers are not
                the headless output's and are not held against the budget. Every
                line says so and names the output, mode and scale; results
                are bench-panel-<regime>-<stamp>.json, marked informational
                inside, and a run of several also writes
                shots/latency/panel-summary-<stamp>.json, which `judge latency`
                does not read and refuses if it is handed one.

  shoot <piece> [state ...] | --pieces a,b | --all [--settings <path>]
                A judged shot with no critic, for looking before one is spent:
                ours built and shot at every judged state of the Piece, or at
                the states named, on the Gate's headless output, cut exactly as
                judge cuts it, into target/gate/shoot/<piece>/ — never under
                shots/, which is a round's. Every check judge makes before a
                window opens is made here, so a shot taken here is the shot
                judge would take. Prints one line per state — the file, and
                whether its pixels are the ones the latest round judged, which
                is what judge reads to carry a verdict forward, or the assertion
                measured off it — then ends in `gate shoot <piece>: shot N
                states (M unchanged since their last round)`, exit 0, or `gate
                shoot <piece>: refused (...)`, exit 3, for every reason judge
                refuses and for a state the Piece has not got. Takes about a
                minute; runs in the foreground. No pair is made and no round
                is written. The trail is target/gate/shoot-<piece>.log.
                --pieces a,b shoots each Piece named and --all every Piece
                with judged states, one build and one stage for all of them:
                each Piece prints its lines and its own `shot N states` line,
                and the run ends in `gate shoot: shot N states over P Pieces
                (M unchanged since their last round)`, or, when a Piece was
                refused, in that Piece's `refused (...)` line and `gate shoot:
                refused (...)`, exit 3, after the others have printed. Several
                Pieces are one stage: a shell loop opening and removing an
                output per Piece hung Hyprland (2026-09-02). A Piece name,
                --pieces and --all each say which, so only one may be given,
                and states go with a name only. The trail of a run of several
                is target/gate/shoot.log.

  judge <piece> [--note <text>] [--summary <file>] [--settings <path>] [--fresh]
                The Ticket tier's blind judging for one Piece: ours built and
                shot at every judged state on a headless output of the Gate's
                own, each shot paired with the frozen Parity oracle under
                shots/blind/<piece>/<state>/ (the key goes to
                $XDG_STATE_HOME/quill/blind-keys/), one fresh critic per pair —
                every state shot first, then every critic at once, so a Piece
                takes one critic's five or six minutes rather than one per
                state — revealed, and written to
                progress/rounds/<piece>-r<N>.json. A state whose shot of ours
                and whose opponent are byte for byte what an earlier round's
                critic was shown carries that round's verdict forward, marked
                `carried` with the round it came from, and no critic is spent
                on it; --fresh asks a critic about every state anyway. The
                whole run outlasts a foreground Bash call's ten-minute cap when
                more than one critic is asked, so an agent runs it in the
                background and reads the last line from the log.
                A state naming an opponent in states.json is paired against the
                Design oracle instead: the rectangle it names in a capture under
                ref/ia/shots/mac-native/ against the matching rectangle of ours,
                which is shot in Mono at the defaults' type so the two grids
                compare cell for cell (ADR 0015). The round names the capture
                and both rectangles.
                A state naming an assert instead is shown to nobody: neither
                oracle holds what it is about, so tools/assert-state.mjs reads
                the rule off ours' own pixels and the state is won or lost on
                that (ADR 0017). The round records what it measured where a
                critic's reasoning would be, and names no opponent for it.
                --note records what changed this round. The Piece is ours only
                when every state is. Ends in `gate judge <piece>: ours|theirs,
                round <N>`: 0 for ours, 1 for theirs, 2 for theirs after this
                Piece had been won, and 3 with `gate judge <piece>: refused
                (...)` when nothing was judged — a command line it could not
                read, a crop that cannot be cut, or an assert this build
                cannot run, included, since 2 is
                spoken for. Above it, one line per state naming the winner,
                the margin and the round it was carried from, and one with the
                winner's gap, so a round is read from the output rather than
                from the letters in the JSON; the trail is
                target/gate/judge-<piece>.log, printed when the run refuses.
                latency is the one Piece with no picture to look at, so it is
                judged by arithmetic instead: it reads the newest whole run
                under shots/latency/, or the one --summary names, and is ours
                when every regime cleared the budget and prose_end_of_draft beat
                the oracle's own keystroke and cold-start numbers. Same round
                file, same line, same four exit codes.
                --settings opens ours with that settings file and reaches ours
                alone: the Parity oracle has no such file, and its shots were
                frozen before the round began. The round's build names the
                path, so a round shot against a rebinding fixture says so.
                latency shoots nothing, and refuses the flag rather than take
                it and record a file that never touched the numbers.

  keys <piece> [--shots <dir>]
                The Ticket tier's condition that types: ours built and opened
                Live — not --deterministic, because the caret machine is what a
                typed condition tests — on a headless output of the Gate's own,
                keyboard focus taken and proved, then the Piece's scripted
                bursts written through /dev/uinput with focus asked again
                between every chunk, and after each burst a capture the Piece's
                assertions are read off. The pixels decide and the app is never
                asked: on #108 the app believed its own caret was at x=0, so a
                probe would have agreed with the defect in good faith. The
                scripts are the `keys` entries of shots/oracle/states.json,
                beside the judged states, and a Piece may carry none. --shots
                keeps each burst's capture as well, which is how the fixtures
                under tools/keys-fixture were taken. Ends in `gate keys <piece>:
                pass` or `gate keys <piece>: fail (<the assertion, measured
                against what it expected>)`: 0 for pass, 1 for fail, and 3 with
                `gate keys <piece>: refused (...)` when nothing was typed or
                nothing could be read — no script for that Piece, no compositor,
                a binary that would not build, or focus taken away mid-run.
                Everything said on the way is target/gate/keys-<piece>.log,
                printed when the run refuses.

The tiers these commands serve are docs/agents/gate.md.
EOF
}

# The step about to run, named, with the command it stands for.
step() { printf 'gate check: %s (%s)\n' "$1" "$2"; }

# The last line, and the exit code that agrees with it.
fail() { printf 'gate check: fail (%s)\n' "$1"; exit 1; }

# Formatting is applied, not checked: every session since #162 failed --check
# only inside this command, a whole run each time, for a change rustfmt makes
# itself. The step line names what it changed, so the owner still reads it and
# the session commits it with the rest; rustfmt's own failure is a red step.
fmt_step() {
    local changed log=$PWD/target/gate/fmt.log
    mkdir -p "$(dirname "$log")"
    if changed=$(cargo fmt -- --check -l 2> "$log"); then
        step fmt "cargo fmt: nothing to change"
        return 0
    fi
    cargo fmt > "$log" 2>&1 || { cat "$log"; fail fmt; }
    step fmt "cargo fmt applied: $(printf '%s\n' "$changed" | sed "s#^$PWD/##" | paste -sd, -)"
}

# One step: its line, then its command with every word of its output — cargo's
# and this script's alike — held in the step's log. A green step is its line and
# nothing more; a red one hands the log over before the line the owner reads.
# The log sits where the build output does, under the directory being checked,
# so a check on the fixture leaves nothing behind in the repo.
run_step() {
    local name=$1 what=$2 log=$PWD/target/gate/$1.log; shift 2
    step "$name" "$what"
    mkdir -p "$(dirname "$log")"
    "$@" > "$log" 2>&1 || { cat "$log"; fail "$name"; }
}

# Every Rust file cargo compiles in the workspace being checked, from cargo's
# own idea of it. The directories come from the packages' targets rather than
# from a list of names kept here, so a crate that keeps its sources somewhere
# unusual is still read — and a crate that keeps Rust which is *not* part of it
# (the fixture keeps its defects that way) does not have that read as its own.
sources() {
    local metadata; local -a where=()
    metadata=$(cargo metadata --no-deps --format-version 1)
    mapfile -t where < <(printf '%s' "$metadata" | python3 -c '
import json, os, sys

where = []
for package in json.load(sys.stdin)["packages"]:
    root = os.path.dirname(package["manifest_path"])
    for target in package["targets"]:
        # A target at the top of the package (build.rs) is itself; anything
        # deeper stands for the directory it lives in, modules and all.
        source = target["src_path"]
        where.append(source if os.path.dirname(source) == root else os.path.dirname(source))
for path in sorted(set(where)):
    print(path)')
    [ ${#where[@]} -gt 0 ] || { echo "gate: cargo metadata named no sources to read" >&2; return 1; }
    find "${where[@]}" -type f -name '*.rs' -not -path '*/target/*'
}

# docs/agents/gate.md: an #[allow(...)] carries a one-line reason on the same
# line. Checked here rather than remembered, and named by file and line. A step
# that read nothing is a failure, not a pass: silence has to mean silence.
allow_reasons() {
    local found status file lineno line; local -a files=() bare=()
    mapfile -t files < <(sources)
    [ ${#files[@]} -gt 0 ] || { echo "gate: no Rust to read" >&2; return 1; }

    # grep says 1 for "nothing matched", which is the good news here; anything
    # above that is grep failing, and a failure must not read as clean.
    # `/dev/null` keeps the file name on the line when there is one file.
    found=$(grep -nE '#!?\[allow\(' "${files[@]}" /dev/null) && status=0 || status=$?
    [ "$status" -le 1 ] || { echo "gate: could not read the sources" >&2; return 1; }

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        file=${line%%:*}; line=${line#*:}
        lineno=${line%%:*}; line=${line#*:}
        # The reason is a comment with something in it, on the attribute's own
        # line. A `///` or `//!` line quoting the attribute carries one by
        # construction.
        case "$line" in *'//'*[![:space:]]*) continue ;; esac
        bare+=("${file#"$PWD"/}:$lineno:${line#"${line%%[![:space:]]*}"}")
    done <<< "$found"

    [ ${#bare[@]} -eq 0 ] && return 0
    printf '%s\n' "${bare[@]}"
    echo "an #[allow(...)] carries its reason as a comment on the same line (docs/agents/gate.md)"
    return 1
}

# CODING_STANDARDS.md § Shape: a float becomes an integer once, at the end, in
# a named helper. The helpers, as `<file>:<fn>` relative to the directory being
# checked, each with the reason it rounds; a new one is added here with its
# reason, and the step below holds every `.round() as` (floor, ceil, trunc) in
# the sources to this list.
ROUND_ONCE=(
    quill/src/tags.rs:pixels               # the shape itself: a length as whole pixels, for the whole app crate
    quill/src/editor.rs:buffer_px          # a pointer or a viewport coordinate in the whole pixels GtkTextView counts in
    quill/src/chrome.rs:reading_time       # seconds to the nearest minute, for the word count's bar
    quill-engine/src/theme.rs:channel      # a colour channel in 0.0–1.0 to a byte, for both crates
    quill-engine/src/typography.rs:measure # the 64-cell measure in whole pixels
    quill-engine/src/typography.rs:hang    # a heading's hang in whole pixels
    quill-engine/src/typography.rs:page_bottom # the page bottom in whole pixels
    quill-engine/src/render.rs:units       # a rendered page's pixels in the units Pango counts in
    quill-engine/src/paginate.rs:zoom      # the render pass's zoom as the whole percentage it takes
    quill-engine/src/typography.rs:an_old_size_in_pixels_takes_the_rung_above_it_and_never_shrinks # a test reading NOTES's em down to its last whole pixel
)

# The enclosing function of line $2 in $1: the nearest `fn <name>` line above it,
# or nothing when there is none (a site at module level).
enclosing_fn() {
    awk -v n="$2" '
        NR > n { exit }
        /^[[:space:]]*(pub(\([^)]*\))?[[:space:]]+)?((const|async|unsafe|extern "C")[[:space:]]+)*fn[[:space:]]+[A-Za-z_][A-Za-z_0-9]*/ {
            name = $0; sub(/.*fn[[:space:]]+/, "", name); sub(/[^A-Za-z_0-9].*/, "", name)
        }
        END { print name }' "$1"
}

# Every float-to-integer cast in the sources sits in a helper ROUND_ONCE names,
# by file and by the fn the site is in. Named by file and line like the
# #[allow] step, and a step that read nothing is a failure for the same reason.
round_once() {
    local found status file lineno fn line here; local -a files=() stray=()
    mapfile -t files < <(sources)
    [ ${#files[@]} -gt 0 ] || { echo "gate: no Rust to read" >&2; return 1; }

    found=$(grep -nE '\.(round|floor|ceil|trunc)\(\) as ' "${files[@]}" /dev/null) && status=0 || status=$?
    [ "$status" -le 1 ] || { echo "gate: could not read the sources" >&2; return 1; }

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        file=${line%%:*}; line=${line#*:}
        lineno=${line%%:*}; line=${line#*:}
        fn=$(enclosing_fn "$file" "$lineno")
        here=${file#"$PWD"/}:$fn
        case " ${ROUND_ONCE[*]} " in *" $here "*) continue ;; esac
        stray+=("${file#"$PWD"/}:$lineno:${line#"${line%%[![:space:]]*}"}  (in fn ${fn:-<none>})")
    done <<< "$found"

    [ ${#stray[@]} -eq 0 ] && return 0
    printf '%s\n' "${stray[@]}"
    echo "a float is rounded once, at the end, in a named helper (CODING_STANDARDS.md § Shape); a new one is added to the list in tools/gate with its reason"
    return 1
}

# Every citation in docs/design.md, progress/state.json and
# shots/oracle/states.json resolves: `ADR NNNN` to a file under docs/adr/,
# `NOTES § X` and `VERDICTS § X` to a heading of the capture notes (a bare
# number is `State N`), and `design.md row <Name>` (or `rows <A>, <B> and <C>`)
# to a row of docs/design.md § Rows. A `design.md row` followed by a lowercase
# word ("a design.md row has left ...") is prose, not a citation. The JSON is
# read as text, so a line number is the file's own.
citations_resolve() {
    python3 - <<'PY'
import glob, re, sys

FILES = ["docs/design.md", "progress/state.json", "shots/oracle/states.json"]
SECTION_END = r'[^,.;:)|"`\\\n]*'
NUMBERED = re.compile(r"\d+")

def headings(path):
    heads = []
    for line in open(path, encoding="utf-8"):
        m = re.match(r"#+ (.*)", line)
        if m:
            heads.append(m.group(1).strip())
    return heads

def rows():
    names, in_rows = [], False
    for line in open("docs/design.md", encoding="utf-8"):
        if line.startswith("## "):
            in_rows = line.startswith("## Rows")
        elif in_rows and line.startswith("| "):
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if cells and cells[0] and not set(cells[0]) <= set("-: "):
                names.append(cells[0])
    return sorted(names, key=len, reverse=True)

def heading_resolves(section, heads):
    section = section.strip()
    if NUMBERED.fullmatch(section):
        section = f"State {section}"
    for head in heads:
        # The heading as cited, or the citation running on into prose after
        # the heading's own words ("NOTES § State 14 says ..."). The cited
        # text is the heading's whole first phrase: what follows it in the
        # heading is its end, a space and a word, or punctuation — a space and
        # a digit is a longer name, so `State` is not `State 9`, and a letter
        # or a digit is a longer word, so `State 9` is not `State 99`.
        short = re.split(r" — |: ", head)[0]
        if re.match(re.escape(section) + r"($| [^0-9]|[^A-Za-z0-9 ])", head):
            return True
        if re.match(re.escape(short) + r"(?![A-Za-z0-9])", section):
            return True
    return False

NOTES = headings("ref/ia/mac-native/NOTES.md")
VERDICTS = headings("ref/ia/mac-native/VERDICTS.md")
ROWS = rows()
ADRS = {m.group(1) for p in glob.glob("docs/adr/*.md") for m in [re.match(r".*/(\d{4})-", p)] if m}

def row_names(text):
    # The row names cited, longest known name first and whole (a name ends at
    # a word boundary, so `Selection` is not `Selectionist`), joined by ", " or
    # " and ". Every capitalised name after a separator is a citation and must
    # resolve; a lowercase word there is prose ("row Selection and the ...").
    # Answers the names that resolved and the first cited name that did not,
    # or None.
    names = []
    while True:
        hit = next((r for r in ROWS if re.match(re.escape(r) + r"(?![A-Za-z0-9])", text)), None)
        if hit is None:
            cited = re.split(r"[,.;:)|\"`]", text)[0].strip()
            return names, cited if re.match(r"[A-Z]", text) else None
        names.append(hit)
        text = text[len(hit):]
        for sep in (", ", " and "):
            if text.startswith(sep):
                text = text[len(sep):]
                break
        else:
            return names, None

unresolved = []
for path in FILES:
    for lineno, line in enumerate(open(path, encoding="utf-8"), 1):
        for m in re.finditer(r"ADR (\d{4})", line):
            if m.group(1) not in ADRS:
                unresolved.append((path, lineno, m.group(0)))
        for m in re.finditer(r"(NOTES|VERDICTS) § (" + SECTION_END + ")", line):
            heads = NOTES if m.group(1) == "NOTES" else VERDICTS
            if not heading_resolves(m.group(2), heads):
                unresolved.append((path, lineno, f"{m.group(1)} § {m.group(2).strip()}"))
        for m in re.finditer(r"design\.md rows? ([A-Z][^\n]*)", line):
            names, missing = row_names(m.group(1))
            if missing is not None:
                unresolved.append((path, lineno, f"design.md row {missing}"))

for path, lineno, cited in unresolved:
    print(f"{path}:{lineno}: {cited} resolves to nothing")
if unresolved:
    print("every ADR NNNN, NOTES §, VERDICTS § and design.md row citation in these files names a file, a heading or a row that exists (docs/agents/gate.md)")
    sys.exit(1)
PY
}

# progress/state.json and shots/oracle/states.json are Node's
# JSON.stringify(v, null, 2) byte for byte — the shape judge.mjs writes a
# round in — so a scripted edit is a small diff and a hand edit is held to it.
canonical_json() {
    local file status=0
    for file in progress/state.json shots/oracle/states.json; do
        node -e '
const fs = require("fs");
const file = process.argv[1];
const raw = fs.readFileSync(file, "utf8");
if (JSON.stringify(JSON.parse(raw), null, 2) + "\n" !== raw) {
  console.log(`${file}: not canonical; rewrite it with node -e '"'"'const fs=require("fs"),f=process.argv[1];fs.writeFileSync(f,JSON.stringify(JSON.parse(fs.readFileSync(f,"utf8")),null,2)+"\\n")'"'"' ${file}`);
  process.exit(1);
}' "$file" || status=1
    done
    [ "$status" -eq 0 ] && return 0
    echo "progress/state.json and shots/oracle/states.json are Node's JSON.stringify(v, null, 2) plus a newline, byte for byte (docs/agents/gate.md)"
    return 1
}

check() {
    local dir=${1:-$ROOT}
    if [ ! -f "$dir/Cargo.toml" ]; then
        echo "gate: $dir: no Cargo.toml to check" >&2
        exit 2
    fi
    cd "$dir"

    fmt_step
    run_step allow "#[allow(...)] carries its reason on the same line" \
        allow_reasons
    run_step round "a float becomes an integer in a named helper" \
        round_once
    # The two below read this repository's docs and judging files, which a
    # `check <dir>` elsewhere has no counterpart of — the same reason the
    # selftests wait for the root, below.
    if [ "$PWD" = "$ROOT" ]; then
        run_step cite "every citation in design.md and state.json resolves" \
            citations_resolve
        run_step json "state.json and states.json are their canonical dump" \
            canonical_json
    fi
    run_step clippy "cargo clippy --all-targets -- -D warnings" \
        cargo clippy --all-targets -- -D warnings
    run_step test "cargo test, with no display attached" \
        env -u DISPLAY -u WAYLAND_DISPLAY -u WAYLAND_SOCKET cargo test
    # Last, and only when the directory being checked is this repository: the
    # bench's join is the one part of the Gate's own tooling that decides what a
    # number means, and it is a pure function of two files, so it is checked on
    # every commit alongside the Rust. Skipped for a `check <dir>` elsewhere,
    # because a step that can only go red for a reason outside <dir> would make
    # `gate check <dir>` mean something other than "this directory is sound" —
    # which is exactly what tools/gate-fixture/selftest points it at.
    if [ "$PWD" = "$ROOT" ]; then
        # Every selftest beside a subcommand, by glob rather than by a list kept
        # here: judge's sat outside this loop for three tickets (#139–#161) and
        # went stale unnoticed. Each is a pure function of files on disk — the
        # bench's join, the typed condition's PNG assertion over the two builds
        # under tools/keys-fixture, the two halves of a blind pair (which states
        # are shot and frozen, and which opponent each is paired with), and the
        # help text against what the scripts print — and none opens a window.
        local selftest
        for selftest in "$ROOT"/tools/*-selftest.mjs; do
            run_step "$(basename "$selftest" -selftest.mjs)" "node tools/$(basename "$selftest")" \
                node "$selftest"
        done
    fi

    echo "gate check: pass"
}

case "${1-}" in
    check) shift; check "$@" ;;
    # The oracle reads a JSON state file, converts offsets and drives a browser
    # through legacy/tools/shoot.mjs, so it is Node; the line it ends in is its
    # own, in the shape the header above asks of every command here.
    oracle) shift; exec node "$ROOT/tools/oracle.mjs" "$@" ;;
    # The bench drives the compositor, a binary and /dev/uinput, and reads the
    # fifteen regimes out of tools/regimes.mjs; it is Node for the same reason
    # the oracle is, and ends in its own line in the same shape.
    bench) shift; exec node "$ROOT/tools/bench.mjs" "$@" ;;
    # Judging drives the compositor, a binary and a critic session, and its exit
    # code is the verdict rather than pass or fail; it is Node for the same
    # reason the oracle is, and ends in its own line in the same shape.
    judge) shift; exec node "$ROOT/tools/judge.mjs" "$@" ;;
    # A judged shot with no critic: judge's own checks, build and cutting,
    # into target/ rather than shots/, for looking before a critic is spent.
    shoot) shift; exec node "$ROOT/tools/shoot.mjs" "$@" ;;
    # The one condition that types and then looks: it drives the compositor, a
    # binary and /dev/uinput as the bench does, and reads the pixels as judging
    # does. Node for the same reason, and ends in its own line in the same shape.
    keys) shift; exec node "$ROOT/tools/keys.mjs" "$@" ;;
    -h | --help | help) usage ;;
    "") usage >&2; exit 2 ;;
    *) echo "gate: ${1}: not a command this Gate has yet" >&2; usage >&2; exit 2 ;;
esac

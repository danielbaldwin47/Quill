#!/usr/bin/env python3
"""Keeps tools/run-cost honest against two written-out transcripts.

    tools/run-cost-selftest

One Claude Code subagent transcript and one Codex rollout, each a few records
in the shape the CLI writes (the fields run-cost reads, and the traps its doc
names: a request split over two records, a duplicated response_id, the
placeholder output_tokens), fed to run-cost and its lines held to the sums
worked by hand here.
"""
import json
import os
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
RUN_COST = os.path.join(HERE, "run-cost")

CLAUDE = [
    # one request, two records: a text block then a tool_use, usage repeated
    {"type": "assistant", "uuid": "a", "requestId": "r1", "timestamp": "2026-09-07T02:00:00Z",
     "message": {"model": "claude-opus-5", "content": [{"type": "text", "text": "x" * 400}],
                 "usage": {"input_tokens": 100, "cache_read_input_tokens": 1000,
                           "cache_creation_input_tokens": 200, "output_tokens": 2,
                           "cache_creation": {"ephemeral_5m_input_tokens": 200,
                                              "ephemeral_1h_input_tokens": 0}}}},
    {"type": "assistant", "uuid": "b", "requestId": "r1", "timestamp": "2026-09-07T02:00:01Z",
     "message": {"model": "claude-opus-5",
                 "content": [{"type": "tool_use", "input": {"command": "y" * 40}}],
                 "usage": {"input_tokens": 100, "cache_read_input_tokens": 1000,
                           "cache_creation_input_tokens": 200, "output_tokens": 9,
                           "cache_creation": {"ephemeral_5m_input_tokens": 200,
                                              "ephemeral_1h_input_tokens": 0}}}},
    # a second request, an hour-TTL write, one tool call
    {"type": "assistant", "uuid": "c", "requestId": "r2", "timestamp": "2026-09-07T02:06:00Z",
     "message": {"model": "claude-opus-5",
                 "content": [{"type": "tool_use", "input": {}}],
                 "usage": {"input_tokens": 0, "cache_read_input_tokens": 1300,
                           "cache_creation_input_tokens": 50, "output_tokens": 1,
                           "cache_creation": {"ephemeral_5m_input_tokens": 0,
                                              "ephemeral_1h_input_tokens": 50}}}},
    {"type": "user", "uuid": "d", "timestamp": "2026-09-07T02:06:01Z", "message": {}},
]
# request r1: in 100, w5 200, read 1000, chars 400 + len('{"command": "yyy…"}') = 400 + 55 -> 113 out
# request r2: read 1300, w1h 50, chars len('{}') = 2 -> 0 out; peak context 1350
# cost: (100*5 + 200*6.25 + 50*10 + 2300*0.5 + 113*25) / 1e6 = $0.00625 -> $0.01
CLAUDE_LINES = [
    "claude-opus-5: 2 API calls, 2 tool calls, peak context 1k, 6.0 min",
    "  input 100  cache-write 250  cache-read 2,300  output ~113 (floor)",
    "  cost $0.01 at $5.00/$0.50/$25.00 per MTok input/cached/output",
]

CODEX = [
    {"type": "session_meta", "timestamp": "2026-09-07T03:00:00Z",
     "payload": {"id": "t1", "source": "cli"}},
    {"type": "turn_context", "timestamp": "2026-09-07T03:00:01Z", "payload": {"model": "gpt-x"}},
    {"type": "response_item", "timestamp": "2026-09-07T03:00:02Z",
     "payload": {"type": "custom_tool_call", "name": "exec"}},
    {"type": "token_usage_record", "timestamp": "2026-09-07T03:00:03Z",
     "payload": {"response_id": "p1", "usage": {
         "input_tokens": 5000, "cached_input_tokens": 4000, "cache_write_input_tokens": 0,
         "output_tokens": 300, "reasoning_output_tokens": 100}}},
    # the same response recorded twice: counted once
    {"type": "token_usage_record", "timestamp": "2026-09-07T03:00:03Z",
     "payload": {"response_id": "p1", "usage": {
         "input_tokens": 5000, "cached_input_tokens": 4000, "cache_write_input_tokens": 0,
         "output_tokens": 300, "reasoning_output_tokens": 100}}},
    {"type": "response_item", "timestamp": "2026-09-07T03:02:00Z",
     "payload": {"type": "function_call", "name": "spawn"}},
    {"type": "token_usage_record", "timestamp": "2026-09-07T03:03:00Z",
     "payload": {"response_id": "p2", "usage": {
         "input_tokens": 7000, "cached_input_tokens": 6500, "cache_write_input_tokens": 0,
         "output_tokens": 50, "reasoning_output_tokens": 0}}},
]
# uncached 1000 + 500 = 1500, cached 10,500, output 350, peak 7000; 03:00:02 -> 03:03:00 = 3 min
# at 4/0.40/20: (1500*4 + 10500*0.4 + 350*20) / 1e6 = $0.0172 -> $0.02
CODEX_LINES = [
    "gpt-x: 2 API calls, 2 tool calls, peak context 7k, 3.0 min",
    "  input 1,500  cache-write 0  cache-read 10,500  output 350 (reasoning 100)",
    "  cost $0.02 at $4.00/$0.40/$20.00 per MTok input/cached/output",
]


def run(records, *flags):
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as fh:
        for rec in records:
            fh.write(json.dumps(rec) + "\n")
        path = fh.name
    try:
        done = subprocess.run([RUN_COST, path, *flags], capture_output=True, text=True)
    finally:
        os.unlink(path)
    return done


def main():
    failed = 0
    for name, records, flags, want, code in (
        ("claude", CLAUDE, (), CLAUDE_LINES, 0),
        ("codex", CODEX, ("--price", "4,0.40,20"), CODEX_LINES, 0),
        ("codex unpriced", CODEX, (), ["gpt-x: 2 API calls, 2 tool calls, peak context 7k, 3.0 min"], 2),
    ):
        done = run(records, *flags)
        got = done.stdout.splitlines()
        ok = done.returncode == code and got[:len(want)] == want
        if code == 2:
            ok = ok and "pass --price" in done.stderr
        print(f"{'ok' if ok else 'FAIL'} {name}")
        if not ok:
            failed += 1
            print(f"  exit {done.returncode}, wanted {code}")
            for line in got:
                print(f"  got:  {line}")
            for line in want:
                print(f"  want: {line}")
            if done.stderr:
                print(f"  stderr: {done.stderr.strip()}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
